{
  "realm": "rbac-demo",
  "displayName": "RBAC Demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "client": {
      "rbac-api": [
        {
          "name": "admin",
          "description": "Administrator: full access to orders and the admin endpoints",
          "composite": true,
          "composites": {
            "client": {
              "rbac-api": [
                "order:read",
                "order:write",
                "order:delete"
              ]
            }
          }
        },
        {
          "name": "user",
          "description": "Regular user: may read orders",
          "composite": true,
          "composites": {
            "client": {
              "rbac-api": [
                "order:read"
              ]
            }
          }
        },
        {
          "name": "order:read",
          "description": "Permission: list and view orders"
        },
        {
          "name": "order:write",
          "description": "Permission: create orders"
        },
        {
          "name": "order:delete",
          "description": "Permission: delete orders"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "rbac-api",
      "name": "RBAC API (resource server)",
      "description": "Owns the fine-grained permission roles and is the audience of access tokens",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "rbac-wpf",
      "name": "RBAC WPF client",
      "description": "Desktop client using Authorization Code + PKCE with a loopback redirect",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://127.0.0.1:7890/*",
        "http://localhost:7890/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:7890/*##http://localhost:7890/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "rbac-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rbac-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "rbac-test-cli",
      "name": "RBAC smoke-test client (TEST ONLY)",
      "description": "Password grant enabled so scripts/smoke-test.ps1 can fetch tokens without a browser. Do not use in production.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "rbac-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rbac-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "rbac-console",
      "name": "RBAC console (Authorization Services)",
      "description": "Confidential client with Keycloak Authorization Services enabled. src/Rbac.Cli logs test users in with the password grant (TEST ONLY) and asks this client for permission decisions.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "rbac-console-secret",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "scopes": [
          {
            "name": "order:read",
            "displayName": "Read orders"
          },
          {
            "name": "order:write",
            "displayName": "Create orders"
          },
          {
            "name": "order:delete",
            "displayName": "Delete orders"
          },
          {
            "name": "audit:read",
            "displayName": "Read the audit log"
          }
        ],
        "resources": [
          {
            "name": "Orders",
            "displayName": "Orders",
            "type": "urn:rbac-demo:resources:orders",
            "ownerManagedAccess": false,
            "uris": [
              "/api/orders/*"
            ],
            "scopes": [
              {
                "name": "order:read"
              },
              {
                "name": "order:write"
              },
              {
                "name": "order:delete"
              }
            ]
          },
          {
            "name": "Audit log",
            "displayName": "Audit log",
            "type": "urn:rbac-demo:resources:audit",
            "ownerManagedAccess": false,
            "uris": [
              "/api/admin/audit"
            ],
            "scopes": [
              {
                "name": "audit:read"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "Is admin",
            "description": "Grants when the user has the rbac-api client role 'admin'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"rbac-api/admin\", \"required\": false}]"
            }
          },
          {
            "name": "Has order:read",
            "description": "Grants when the user has the rbac-api client role 'order:read'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"rbac-api/order:read\", \"required\": false}]"
            }
          },
          {
            "name": "Has order:write",
            "description": "Grants when the user has the rbac-api client role 'order:write'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"rbac-api/order:write\", \"required\": false}]"
            }
          },
          {
            "name": "Has order:delete",
            "description": "Grants when the user has the rbac-api client role 'order:delete'",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\": \"rbac-api/order:delete\", \"required\": false}]"
            }
          },
          {
            "name": "Read orders",
            "description": "Orders#order:read requires policy 'Has order:read'",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Orders\"]",
              "scopes": "[\"order:read\"]",
              "applyPolicies": "[\"Has order:read\"]"
            }
          },
          {
            "name": "Write orders",
            "description": "Orders#order:write requires policy 'Has order:write'",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Orders\"]",
              "scopes": "[\"order:write\"]",
              "applyPolicies": "[\"Has order:write\"]"
            }
          },
          {
            "name": "Delete orders",
            "description": "Orders#order:delete requires policy 'Has order:delete'",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Orders\"]",
              "scopes": "[\"order:delete\"]",
              "applyPolicies": "[\"Has order:delete\"]"
            }
          },
          {
            "name": "Read audit log",
            "description": "Audit log#audit:read requires policy 'Is admin'",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Audit log\"]",
              "scopes": "[\"audit:read\"]",
              "applyPolicies": "[\"Is admin\"]"
            }
          }
        ]
      }
    }
  ],
  "groups": [
    {
      "name": "admins",
      "path": "/admins",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {
        "rbac-api": [
          "admin"
        ]
      },
      "subGroups": []
    },
    {
      "name": "users",
      "path": "/users",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {
        "rbac-api": [
          "user"
        ]
      },
      "subGroups": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "email": "alice@example.com",
      "credentials": [
        {
