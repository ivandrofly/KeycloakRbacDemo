<Window x:Class="Consent.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Consent.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Consent Demo - Keycloak"
        Width="1000" Height="640" MinWidth="800" MinHeight="500"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Brush.Text}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Consent Demo" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Realm consent-demo · public client consent-wpf (consent required, keycloak.v2) · the user decides which scopes this app gets" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                Orientation="Vertical" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right">
                            <Run Text="Signed in as" Foreground="{StaticResource Brush.Muted}" />
                            <Run Text="{Binding UserName, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" Text="{Binding TokenExpires}" />
                    </StackPanel>
                    <Button Content="Sign out" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Logged-out: choose scopes, then sign in ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="40,30" MaxWidth="560" Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="What may this app know about you?" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Always requested (default client scopes):" />
                    <Run Text="{Binding BaseScopesText, Mode=OneWay}" FontWeight="SemiBold" />
                    <LineBreak />
                    <Run Text="Optional client scopes are only requested when you tick them; the consent page lists exactly what was asked for." />
                </TextBlock>

                <!-- TextBlock content: a bare string would turn the underscores into access-key markers -->
                <CheckBox IsChecked="{Binding RequestAddress}" Margin="0,0,0,6">
                    <TextBlock Text="address  (ID token gets an address claim)" />
                </CheckBox>
                <CheckBox IsChecked="{Binding RequestPhone}" Margin="0,0,0,6">
                    <TextBlock Text="phone  (phone_number, phone_number_verified)" />
                </CheckBox>
                <CheckBox IsChecked="{Binding RequestOfflineAccess}" Margin="0,0,0,16">
                    <TextBlock Text="offline_access  (a refresh token that outlives the session)" />
                </CheckBox>

                <Button Content="Sign in with Keycloak" Command="{Binding LoginCommand}" HorizontalAlignment="Center" Margin="0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"
                           Text="Try dave or erin. Password = username." />
            </StackPanel>
        </Border>

        <!-- ================= Logged-in content ================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: what Keycloak granted -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Granted scopes" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,0,0,6">
                        <Run Text="Requested:" />
                        <Run Text="{Binding RequestedScopesText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="· granted (scope claim of the access token):" />
                    </TextBlock>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding GrantedScopes}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}" Background="{StaticResource Brush.PermChip}">
                                    <TextBlock Text="{Binding}" Foreground="#1E7F4F" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="ID token claims" Margin="0,4,0,6" />
                        <ListView ItemsSource="{Binding Claims}" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Claim" Width="170" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Value" Width="380" DisplayMemberBinding="{Binding Value}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Right: the consent itself -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Your consent" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Keycloak stored your decision for consent-wpf: signing in again will not ask until the consent is revoked, or until the app asks for a scope you have not granted yet." />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Revoke calls the account REST API (DELETE /account/applications/consent-wpf/consent) with your own access token, then signs you out locally." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Revoke consent" Style="{StaticResource DangerButton}" Padding="14,6" Margin="0,0,8,0"
                                Command="{Binding RevokeConsentCommand}" />
                        <Button Content="Open account console" Style="{StaticResource SecondaryButton}" Margin="0"
                                Command="{Binding OpenAccountConsoleCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="The account console (Applications) shows the same consent and lets the user revoke it without this app." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" Margin="0,16,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="90" Height="6" IsIndeterminate="True" Margin="12,0,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
